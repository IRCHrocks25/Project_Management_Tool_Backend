# Database Configuration
# Option 1: Use DATABASE_URL (recommended for cloud providers)
# DATABASE_URL=postgresql://username:password@host:port/database

# Option 2: Use individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=katalyst_pm

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here
# Optional: IP whitelist (only needed for external/public webhooks)
# For internal use, leave empty or omit this line
# WEBHOOK_ALLOWED_IPS=1.2.3.4,5.6.7.8

