# Database Configuration
# Option 1: Use DATABASE_URL (recommended for cloud providers)
# DATABASE_URL=postgresql://username:password@host:port/database

# Option 2: Use individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=katalyst_pm

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here
# Token sent in Webhook-Token header when calling n8n (OTP + notification webhooks). Default: katalystPM2026
# WEBHOOK_TOKEN=katalystPM2026
# Optional: IP whitelist (only needed for external/public webhooks)
# For internal use, leave empty or omit this line
# WEBHOOK_ALLOWED_IPS=1.2.3.4,5.6.7.8

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Notification email via n8n webhook. When set, notification emails are sent to this URL (no Resend).
# NOTIFICATION_WEBHOOK_URL=https://katalyst-crm2.fly.dev/webhook/60052967-5dd2-44f1-b81d-771c99f6e133

# Email Configuration (for password reset)
# For Hostpoint: smtp.hostpoint.ch, port 587
# For Gmail: Use App Password (not regular password)
# For Outlook/Hotmail: smtp-mail.outlook.com, port 587
# For other providers, check their SMTP settings
EMAIL_HOST=smtp.hostpoint.ch
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@yourdomain.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=your-email@yourdomain.com
APP_NAME=Katalyst PM

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

