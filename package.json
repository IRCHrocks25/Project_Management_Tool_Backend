{
  "name": "katalyst-pm-backend",
  "version": "1.0.0",
  "description": "Katalyst Project Management Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-http-header-size=16384\" node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "cross-env NODE_OPTIONS=\"--no-deprecation --max-http-header-size=16384\" node node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:archive": "node scripts/add-archive-columns.js",
    "migrate:landing-page-revisions": "node scripts/add-landing-page-revision-count.js",
    "migrate:client-start-date": "node scripts/add-client-start-date.js",
    "migrate:completion": "node scripts/add-completion-columns.js",
    "migrate:password-reset": "node scripts/add-password-reset-fields.js",
    "migrate:otp-fields": "node scripts/add-otp-fields.js",
    "migrate:email-body-nullable": "node scripts/make-email-body-nullable.js",
    "migrate:client-updates": "node scripts/create-client-updates-tables.js",
    "migrate:secondary-client-types": "node scripts/add-secondary-client-types.js",
    "migrate:client-update-comments": "node scripts/create-client-update-comments-table.js",
    "migrate:client-update-notes-links": "node scripts/add-client-update-notes-links.js",
    "migrate:premium-powered-up": "node scripts/add-premium-powered-up-client-types.js",
    "migrate:notification-assigned-to-id": "node scripts/add-notification-assigned-to-id.js",
    "migrate:fix-notification-user-ids": "node scripts/fix-notification-user-ids.js",
    "migrate:task-available-type": "node scripts/add-task-available-notification-type.js",
    "migrate:task-assignees": "node scripts/add-task-assignees-table.js",
    "migrate:team-lead-flag": "node scripts/add-team-lead-flag.js",
    "migrate:head-pm-flag": "node scripts/add-head-pm-flag.js",
    "migrate:landing-page-to-Home Page": "node scripts/update-landing-page-to-Home Page.js",
    "migrate:task-conversations": "node scripts/create-task-conversations-tables.js",
    "migrate:conversation-notification-types": "node scripts/add-conversation-notification-types.js",
    "migrate:chat-tables": "node scripts/create-chat-tables.js",
    "migrate:tickets": "node scripts/create-tickets-table.js",
    "migrate:daily-focus-items": "node scripts/create-daily-focus-items.js",
    "migrate:daily-focus-rank-limit": "node scripts/alter-daily-focus-rank-limit.js",
    "migrate:eod-report-snapshots": "node scripts/create-eod-report-snapshots.js",
    "migrate:department-project-focus": "node scripts/create-department-project-focus-items.js",
    "migrate:department-project-focus-override": "node scripts/create-department-project-focus-override-items.js",
    "migrate:department-project-focus-task-based": "node scripts/alter-department-project-focus-to-task-based.js",
    "migrate:rapid-prospect-client-type": "node scripts/add-rapid-prospect-client-type.js",
    "migrate:onboarding-lifecycle": "node scripts/add-onboarding-lifecycle-columns.js",
    "migrate:rapid-prospect-user-role": "node scripts/add-rapid-prospect-user-role.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.22",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.10",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.9.0",
    "luxon": "^3.7.2",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.35",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
